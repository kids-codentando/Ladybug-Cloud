# Ladybug Cloud — environment configuration
PORT=3000
NODE_ENV=production

# Admin credentials (change these in production!)
ADMIN_USERNAME=Ntando
ADMIN_PASSWORD=mods

# Secret used to sign session cookies (auto-generated on Render)
SESSION_SECRET=change-me-to-a-long-random-string

# Plan limits
FREE_BOT_LIMIT=1
PRO_BOT_LIMIT=10

# Storage (defaults to ./data and ./bots/ladybug when unset)
# DATA_DIR=/var/data
# BOT_DIR=/var/data/bots/ladybug

# Bot source archive used by the installer
BOT_ZIP_URL=https://github.com/kids-codentando/Ladybug-Mini/archive/refs/heads/main.zip

# Set to "false" if you are not serving over HTTPS
COOKIE_SECURE=true
